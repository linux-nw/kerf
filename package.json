{
  "name": "kerf",
  "version": "0.1.0",
  "private": true,
  "description": "Kerf, ein rein lokales Werkzeug für Dateien",
  "main": "./out/main/index.js",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && electron-vite dev",
    "build": "npm run tokens && electron-vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis zip"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@tesseract.js-data/ces": "^1.0.0",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/ita": "^1.0.0",
    "@tesseract.js-data/nld": "^1.0.0",
    "@tesseract.js-data/osd": "^1.0.0",
    "@tesseract.js-data/pol": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@tesseract.js-data/tur": "^1.0.0",
    "@tesseract.js-data/ukr": "^1.0.0",
    "7zip-bin": "^5.2.0",
    "docx": "^9.10.0",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "heic-decode": "^2.1.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "read-excel-file": "^9.3.12",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "write-excel-file": "^4.1.1",
    "yaml": "^2.9.1"
  },
  "author": "linux-nw",
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
